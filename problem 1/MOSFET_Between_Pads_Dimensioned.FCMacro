    "Footprint %s x %s um (pad row %s um). A pass here is NOT foundry sign-off.\n"
    % (n_ok, n_nc, n_fail, n_geom_viol, fmt(BW), fmt(BH),
       fmt(pad_x[-1] - pad_x[0] + PAD)))
